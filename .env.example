# Flask Configuration
FLASK_SECRET_KEY=chronicle_ai_super_secret_session_key_2026
FLASK_ENV=development
PORT=5000

# Groq API Configuration (Get yours at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Configuration (Get from Supabase Project Settings -> API)
# If left empty, Chronicle AI will automatically use local SQLite storage as a fallback!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
